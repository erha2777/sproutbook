# Electron 二进制走 npmmirror 镜像（国内网络必需）
electron_mirror=https://cdn.npmmirror.com/binaries/electron/
electron_builder_binaries_mirror=https://cdn.npmmirror.com/binaries/electron-builder-binaries/

# 使用扁平化（npm 风格）的 node_modules 布局。
#
# 原因：pnpm 默认的「符号链接 + .pnpm 虚拟store」布局在 Windows 上会创建 junction，
# 而 Node 的 ESM 解析器在部分路径下不会 realpath 这些 junction，
# 导致工具链（vite → rollup / fdir 等）解析不到自己的传递依赖，
# 报 ERR_MODULE_NOT_FOUND 或 ERR_PACKAGE_PATH_NOT_EXPORTED。
# 扁平布局让任何层级的解析都能成功，Electron + Vite + electron-builder 组合下更稳定。
node-linker=hoisted

strict-peer-dependencies=false
