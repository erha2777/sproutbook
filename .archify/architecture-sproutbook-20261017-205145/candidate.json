  "cards": [
    {
      "dot": "cyan",
      "title": "进程隔离",
      "items": [
        "contextIsolation 开启、nodeIntegration 关闭",
        "preload 只暴露白名单方法，不交出 ipcRenderer",
        "主进程把错误转成异常，渲染层可直接 try/catch"
      ]
    },
    {
      "dot": "emerald",
      "title": "共享内核",
      "items": [
        "core/ 是纯函数，两端各自打包一份",
        "不 import electron、不碰数据库与文件",
        "所以渲染层能直接算紧急度，不必多跑一次 IPC"
      ]
    },
    {
      "dot": "amber",
      "title": "旁路写入",
      "items": [
        "AI 调用直连 ai_runs 审计表，绕过仓储层",
        "密钥文件以 0600 权限落盘",
        "图片与缩略图由服务层写入 images/"
      ]
    }
  ]
